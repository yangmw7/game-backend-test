{{>layouts/header}}

<h1>게시글 수정</h1>
{{#article}}
    <form class="container" action="/articles/update" method="post">
        <input name="id" type="hidden" value="{{id}}">
        <div class="mb-3">
            <label class="form-label" for="title">제목 {id값 : {{id}}</label>
            <input type="text" value={{title}} class="form-control" id="title" placeholder="name@example.com" name="title" readonly>
        </div>
        <div class="mb-3">
            <label for="exampleFormControlTextarea1" class="form-label">내용</label>
            <textarea class="form-control"  id="exampleFormControlTextarea1" rows="3" name="content" readonly>{{content}}</textarea>
        </div>
    </form>
{{/article}}


<h3> <a href="/articles/{{"</h3>

{{>layouts/footer}}